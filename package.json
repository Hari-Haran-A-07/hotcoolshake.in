{
  "name": "hot-cool-shake",
  "version": "1.0.0",
  "description": "HOT COOL SHAKE - International Coffee & Beverage Experience MERN Application",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "prebuild": "npm install --prefix client",
    "build": "npm run build --prefix client",
    "postinstall": "npm install --prefix client",
    "seed": "node server/seed.js",
    "test:api": "node server/testApi.js",
    "start": "node server/server.js"
  },
  "workspaces": [
    "client"
  ],
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^9.2.0",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
